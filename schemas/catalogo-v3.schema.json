{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo nacional multifonte Plan-Assiste",
  "type": "object",
  "required": ["schema_version", "environment", "authorization", "notices", "sources", "record_count", "records"],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "environment": { "enum": ["demo", "production"] },
    "authorization": { "type": "object" },
    "notices": { "type": "object" },
    "sources": { "type": "array", "minItems": 1 },
    "record_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["public_id", "source_id", "type", "display_name", "specialties", "service_locations", "network_links", "source_updated_at"]
      }
    }
  }
}
