{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projeto.exemplo.br/schemas/catalogo-prestadores-plan-assiste-v1.schema.json",
  "title": "Catálogo público de prestadores — Plan-Assiste MPU",
  "description": "Contrato do catálogo normalizado. Não concede autorização para obtenção ou publicação de dados reais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "generated_at",
    "source",
    "authorization",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "environment": {
      "type": "string",
      "enum": ["demo", "production"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "public_url", "plan_id", "plan_name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "public_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "plan_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "plan_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["synthetic-demo", "authorized"]
        },
        "reference": {
          "type": ["string", "null"],
          "maxLength": 160
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "authorized"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "synthetic-demo"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "production"
          }
        },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "status": {
                "const": "authorized"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "const": "demo"
          }
        },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "status": {
                "const": "synthetic-demo"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "type",
        "display_name",
        "specialties",
        "service_locations",
        "source_updated_at"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "pattern": "^(profissional|estabelecimento)-[a-z0-9-]{8,64}$"
        },
        "type": {
          "type": "string",
          "enum": ["professional", "facility"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "professional_registry": {
          "oneOf": [
            {
              "$ref": "#/$defs/professionalRegistry"
            },
            {
              "type": "null"
            }
          ]
        },
        "specialties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specialty"
          },
          "uniqueItems": true
        },
        "service_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceLocation"
          }
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "professionalRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["council", "state", "number"],
      "properties": {
        "council": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "specialty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rqe"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rqe": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "serviceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facility_public_id",
        "facility_name",
        "phones",
        "address"
      ],
      "properties": {
        "facility_public_id": {
          "type": ["string", "null"],
          "pattern": "^estabelecimento-[a-z0-9-]{8,64}$"
        },
        "facility_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 180
        },
        "phones": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 30
          },
          "uniqueItems": true
        },
        "address": {
          "$ref": "#/$defs/address"
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "district", "city", "state"],
      "properties": {
        "street": {
          "type": ["string", "null"],
          "maxLength": 240
        },
        "district": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "city": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "state": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        }
      }
    }
  }
}
